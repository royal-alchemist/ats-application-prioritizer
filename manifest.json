{
  "manifest_version": 3,
  "name": "Prioritizer",
  "version": "2.2.0",
  "description": "Prioritizes ATS and direct career application tabs.",

  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "scripting"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_title": "Open Prioritizer"
  },

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "ats-rules.js",
        "content.js"
      ],
      "css": [
        "watermark.css"
      ],
      "run_at": "document_start"
    }
  ]
}
